# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: zwave_soc_sensor_pir_eth
label: zwave_soc_sensor_pir_eth
description: |
  The Z-Wave certified passive infrared (PIR) sensor application shows a presence/movement detector implementation for controlling other devices and for sending notifications.
category: Z-Wave|Apps
filter:
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Z-Wave
package: zwave_sample_app
quality: production
readme:
- path: README.md
source:
- path: app.c
- path: SensorPIR_UserTask_DataAcquisition.c
- path: app_cli.c
- path: app_btn_handler.c
tag:
- prebuilt_demo
- hwfilter:!board:brd4205a
- toolchain:llvm
- toolchain:gcc
- hwfilter:device:device_supports_zwave
include:
- path: .
  file_list:
  - path: events.h
  - path: SensorPIR_UserTask_DataAcquisition.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.1
toolchain_settings: [
  ]
